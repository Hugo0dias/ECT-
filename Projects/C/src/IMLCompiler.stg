        }

        public static ImagePlus adjustVerticalAndHorizontalScale(ImagePlus img, double scale) {
            ImageProcessor ip = img.getProcessor();
            int newWidth = (int) Math.round(ip.getWidth() * scale);
            int newHeight = (int) Math.round(ip.getHeight() * scale);
            ImageProcessor resized = ip.resize(newWidth, newHeight);
            return new ImagePlus("rescaled", resized);
        }

        public static ImagePlus adjustVerticalAndHorizontalScale(ImagePlus img, double scaleX, double scaleY) {
            ImageProcessor ip = img.getProcessor();
            int newWidth = (int) Math.round(ip.getWidth() * scaleX);
            int newHeight = (int) Math.round(ip.getHeight() * scaleY);
            ImageProcessor resized = ip.resize(newWidth, newHeight);
            return new ImagePlus("rescaled", resized);
        }

        public static ImagePlus dilate(ImagePlus img, ImagePlus kernel) {
            ImageProcessor ip = img.getProcessor().duplicate();
            Binary binary = new Binary();
            binary.setup("dilate", img);
            binary.run(ip);
            return new ImagePlus("dilated", ip);
        }

        public static ImagePlus divide(ImagePlus img1, ImagePlus img2) {
            if (img1 == null || img2 == null) {
                System.err.println("Uma das imagens é nula.");
                return null;
            }
        
            if (img1.getWidth() != img2.getWidth() || img1.getHeight() != img2.getHeight()) {
                System.err.println("As imagens devem ter o mesmo tamanho para divisão.");
                return null;
            }
        
            ImageProcessor proc1 = img1.getProcessor().duplicate();
            ImageProcessor proc2 = img2.getProcessor();
        
            proc1.copyBits(proc2, 0, 0, Blitter.DIVIDE);
            return new ImagePlus("Divided Image", proc1);
        }


        public static int countPixel(Double targetValue, ImagePlus image) {
            if (image == null || targetValue == null) {
                throw new IllegalArgumentException("Image or value cannot be null.");
            }

            ImageProcessor proc = image.getProcessor();
            int width = proc.getWidth();
            int height = proc.getHeight();
            int count = 0;

            for (int y = 0; y \< height; y++) {
                for (int x = 0; x \< width; x++) {
                    int pixelValue = proc.getPixel(x, y);
                    if (pixelValue == targetValue.intValue()) {
                        count++;
                    }
                }
            }

            return count;
        }

        public static ImagePlus sub(ImagePlus a, ImagePlus b) {
            ImageProcessor procA = a.getProcessor().duplicate();
            ImageProcessor procB = b.getProcessor();
            procA.copyBits(procB, 0, 0, Blitter.SUBTRACT);
            ImagePlus i = new ImagePlus("subtracted", procA);
            return binarize(i);
        }

        
        

        public static ImagePlus binarize(ImagePlus image) {
            ImageProcessor ip = image.getProcessor().duplicate();
            int width = ip.getWidth();
            int height = ip.getHeight();
            for (int y = 0; y \< height; y++) {
                for (int x = 0; x \< width; x++) {
                    double val = ip.getPixelValue(x, y);
                    ip.putPixelValue(x, y, Math.abs(val) \> 1e-3 ? 255 : 0);
                }
            }
            return new ImagePlus("binarized", ip);
        }


        public static ImagePlus erode(ImagePlus img, ImagePlus kernel) {
            ImageProcessor ip = img.getProcessor().duplicate(); // duplica para não alterar a original
            Binary binary = new Binary();
            binary.setup("erode", img);
            binary.run(ip);
            return new ImagePlus("eroded", ip);
        }



        public static boolean AnyPixelgreaterThan(ImagePlus img, int threshold) {
            ImageProcessor ip = img.getProcessor();
            int width = ip.getWidth();
            int height = ip.getHeight();

            for (int y = 0; y \< height; y++) {
                for (int x = 0; x \< width; x++) {
                    int pixelValue = ip.getPixel(x, y);
                    if (pixelValue > threshold) {
                        return true;
                    }
                }
            }
            return false;
        }

