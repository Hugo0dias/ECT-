        public static ImagePlus loadImage(String path) {
            
            path = "../examples/" + path;  // corrigir path relativo à raiz
            System.out.println("Imagem salva com sucesso em: " + path);

            ImagePlus image = IJ.openImage(path);
            if (image == null) {
                System.out.println("Erro: Não foi possível carregar a imagem em " + path);
            }
            return image;
        }


        public static void draw(ImagePlus image) {
            if (image == null) {
                System.err.println("Erro: imagem nula. Nada a desenhar.");
                return;
            }
            image.show();  // Mostra a imagem em uma janela do ImageJ
        }

        public static void storeImage(List\<ImagePlus\> images, String path) {
            if (images == null || images.isEmpty()) {
                System.err.println("Erro: lista de imagens vazia.");
                return;
            }

            int width = images.get(0).getWidth();
            int height = images.get(0).getHeight();
            ImageStack stack = new ImageStack(width, height);

            for (ImagePlus img : images) {
                stack.addSlice(img.getProcessor());
            }

            ImagePlus result = new ImagePlus("animation", stack);
            path = "../examples/" + path;

            boolean success = new FileSaver(result).saveAsGif(path);
            if (success) {
                System.out.println("GIF salvo com sucesso em: " + path);
            } else {
                System.err.println("Erro ao salvar o GIF.");
            }
        }


        public static void storeImage(ImagePlus image, String path) {
            if (image == null) {
                System.err.println("Erro: imagem nula. Nada a salvar.");
                return;
            }
        
            path = "../examples/" + path;
            boolean success = new FileSaver(image).saveAsPgm(path); // Salva como PGM (ou troca por saveAsJpeg, etc.)
        
            if (success) {
                System.out.println("Imagem salva com sucesso em: " + path);
            } else {
                System.err.println("Erro ao salvar imagem em: " + path);
            }
        }

        public static void output(ImagePlus image) {
            if (image == null) {
                System.err.println("Erro: imagem nula. Nada a imprimir.");
                return;
            }

            System.out.println("=== Metadados da Imagem ===");
            System.out.println("Título: " + image.getTitle());
            System.out.println("Largura: " + image.getWidth());
            System.out.println("Altura: " + image.getHeight());
            System.out.println("Profundidade de bits: " + image.getBitDepth());
            System.out.println("Número de canais: " + image.getNChannels());
            System.out.println("Número de slices: " + image.getNSlices());
            System.out.println("Número de frames: " + image.getNFrames());
        }

    }

}

>>

