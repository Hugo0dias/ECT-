    static class MorphologyWithImageJ {

        public static ImagePlus processIIML(String filePath) {
            
            try (InputStream fileInput = new FileInputStream(filePath)) {
               CharStream input = CharStreams.fromStream(fileInput);
               GrammarIIMLLexer lexer = new GrammarIIMLLexer(input);
               CommonTokenStream tokens = new CommonTokenStream(lexer);
               GrammarIIMLParser parser = new GrammarIIMLParser(tokens);

               ParseTree tree = parser.program();

               if (parser.getNumberOfSyntaxErrors() == 0) {
                  IIMLImageGenerator visitor = new IIMLImageGenerator();
                  return (ImagePlus) visitor.visit(tree);
               } else {
                  System.err.println("Syntax errors found.");
               }
            } catch (IOException | RecognitionException e) {
               e.printStackTrace();
            }
            return null;
        }

        public static ImagePlus runSec(String filePath) {
            return processIIML(filePath);
        }

        public static String ToString(Object input) {
            if (input == null) return "null";
            if (input instanceof ImagePlus) {
                return "ImagePlus[" + ((ImagePlus) input).getTitle() + "]";
            }
            return input.toString();
        }
    
        public static ImagePlus toImagePlus(Object input) {
            if (input instanceof ImagePlus) {
                return (ImagePlus) input;
            } else if (input instanceof Number) {
                int value = ((Number) input).intValue();
                ByteProcessor bp = new ByteProcessor(1, 1);
                bp.set(0, 0, value);
                return new ImagePlus("ConvertedNumber", bp);
            } else if (input instanceof Boolean) {
                int v = (Boolean) input ? 255 : 0;
                ByteProcessor bp = new ByteProcessor(1, 1);
                bp.set(0, 0, v);
                return new ImagePlus("ConvertedBoolean", bp);
            } else if (input instanceof String) {
                // Assumir que é um caminho para imagem
                return new ImagePlus((String) input);
            }
            return null;
        }
    
        public static Number toNumber(Object input) {
            if (input instanceof Number) {
                return (Number) input;
            } else if (input instanceof String) {
                try {
                    return Double.parseDouble((String) input);
                } catch (NumberFormatException e) {
                    return 0;
                }
            } else if (input instanceof Boolean) {
                return (Boolean) input ? 1 : 0;
            } else if (input instanceof ImagePlus) {
                return ((ImagePlus) input).getProcessor().getPixel(0, 0);
            }
            return 0;
        }
    
        public static Double toDouble(Object input) {
            Number n = toNumber(input);
            return n.doubleValue();
        }
    
        public static Boolean toBoolean(Object input) {
            if (input instanceof Boolean) {
                return (Boolean) input;
            } else if (input instanceof Number) {
                return ((Number) input).doubleValue() != 0.0;
            } else if (input instanceof String) {
                String s = ((String) input).trim().toLowerCase();
                return s.equals("true") || s.equals("1") || s.equals("yes");
            } else if (input instanceof ImagePlus) {
                int pixel = ((ImagePlus) input).getProcessor().getPixel(0, 0);
                return pixel != 0;
            }
            return false;
        }

        public static ImagePlus FlipHorizontal(ImagePlus img) {
            ImageProcessor ip = img.getProcessor().duplicate();
            ip.flipHorizontal();  // Flip along vertical axis (left ↔ right)
            return new ImagePlus("Flipped Horizontal", ip);
        }

        public static ImagePlus FlipVertical(ImagePlus img) {
            ImageProcessor ip = img.getProcessor().duplicate();
            ip.flipVertical();  // Flip along horizontal axis (top ↔ bottom)
            return new ImagePlus("Flipped Vertical", ip);
        }

        public static ImagePlus FlipVerticalAndHorizontal(ImagePlus img) {
            ImageProcessor ip = img.getProcessor().duplicate();
            ip.flipHorizontal();
            ip.flipVertical();
            return new ImagePlus("Flipped Both", ip);
        }
        
        public static ImagePlus blackHat(ImagePlus imp, Object kernel) {
            // 1. Ensure 8-bit grayscale
            if (imp.getType() != ImagePlus.GRAY8) {
                IJ.run(imp, "8-bit", "");
            }

            // 2. Duplicate the original image
            ImagePlus result = imp.duplicate();
            ImageProcessor ip = result.getProcessor();

            // 3. Apply morphological CLOSING (dilation + erosion)
            if (kernel == null) {
                // Default circular kernel
                RankFilters rf = new RankFilters();
                rf.rank(ip, 2.0, RankFilters.CLOSE); // radius=2.0
            } 
            else if (kernel instanceof List) {
                // Custom kernel from List
                @SuppressWarnings("unchecked")
                List\<List\<Integer\>\> kernelList = (List\<List\<Integer\>\>) kernel;
                int size = kernelList.size();
                double radius = size / 2.0;

                RankFilters rf = new RankFilters();
                rf.rank(ip, radius, RankFilters.CLOSE);
            }

            // 4. Subtract original from closed (Black Hat)
            ImageProcessor original = imp.getProcessor();
            for (int y = 0; y \< ip.getHeight(); y++) {
                for (int x = 0; x \< ip.getWidth(); x++) {
                    int diff = ip.get(x, y) - original.get(x, y); // Note reversed order vs Top-Hat
                    ip.set(x, y, Math.max(0, diff)); // Clamp to 0-255
                }
            }

            result.setTitle("BlackHat Result");
            return result;
        }
        public static ImagePlus topHat(ImagePlus imp, Object kernel) {
            // 1. Ensure we have an 8-bit grayscale image
            if (imp.getType() != ImagePlus.GRAY8) {
                IJ.run(imp, "8-bit", "");
            }

            // 2. Duplicate the original image
            ImagePlus result = imp.duplicate();
            ImageProcessor ip = result.getProcessor();

            // 3. Apply morphological opening
            if (kernel == null) {
                // Default circular kernel
                RankFilters rf = new RankFilters();
                rf.rank(ip, 2.0, RankFilters.OPEN); // radius=2.0
            } 
            else if (kernel instanceof List) {
                // Custom kernel from List
                @SuppressWarnings("unchecked")
                List\<List\<Integer\>\> kernelList = (List\<List\<Integer\>\>) kernel;
                int size = kernelList.size();
                double radius = size / 2.0;

                // Apply opening with square kernel
                RankFilters rf = new RankFilters();
                rf.rank(ip, radius, RankFilters.OPEN);
            }

            // 4. Subtract opened from original (Top-Hat)
            ImageProcessor original = imp.getProcessor();
            for (int y = 0; y \< ip.getHeight(); y++) {
                for (int x = 0; x \< ip.getWidth(); x++) {
                    int diff = original.get(x, y) - ip.get(x, y);
                    ip.set(x, y, Math.max(0, diff));
                }
            }

            result.setTitle("TopHat Result");
            return result;
        }

        // Convert List\<List\<Integer\>\> to ImagePlus
        // Versão corrigida da função fromList
        public static ImagePlus fromList(List\<List\<Integer\>\> matrix) {
            int height = matrix.size();
            int width = matrix.get(0).size();
            ByteProcessor bp = new ByteProcessor(width, height);

            for (int y = 0; y \< height; y++) {
                List\<Integer\> row = matrix.get(y);  // Especificamos o tipo List<Integer>
                for (int x = 0; x \< width; x++) {
                    int pixelValue = row.get(x);    // Conversão automática de Integer para int
                    bp.set(x, y, pixelValue);      // Usando set() em vez de putPixel
                }
            }
            return new ImagePlus("Converted", bp);
        }

        public static ImagePlus dilate(ImagePlus input, Object kernel) {
            ImageProcessor ip = input.getProcessor().duplicate();

            ImagePlus kernelImage = null;

            if (kernel == null) {
                // Default behavior with no kernel
                ip.dilate();  // ImageJ's basic erosion
                return new ImagePlus("Eroded", ip);
            } else if (kernel instanceof ImagePlus) {
                kernelImage = (ImagePlus) kernel;
                // For now, ignoring custom kernel shape since ImageJ core erode() doesn't take one
                ip.dilate();
            } else if (kernel instanceof List) {
                try {
                    @SuppressWarnings("unchecked")
                    List\<List\<Integer\>\> kernelList = (List\<List\<Integer\>\>) kernel;
                    kernelImage = fromList(kernelList);
                    ip.dilate();  // Or apply logic using kernelImage if needed
                } catch (Exception e) {
                    System.err.println("Invalid kernel List format");
                    ip.dilate();
                }
            } else {
                System.err.println("Unsupported kernel type: " + kernel.getClass());
                ip.dilate(); // fallback
            }

            return new ImagePlus("Eroded", ip);
        }
    
        public static ImagePlus erode(ImagePlus input, Object kernel) {
            ImageProcessor ip = input.getProcessor().duplicate();
    
            ImagePlus kernelImage = null;
    
            if (kernel == null) {
                // Default behavior with no kernel
                ip.erode();  // ImageJ's basic erosion
                return new ImagePlus("Eroded", ip);
            } else if (kernel instanceof ImagePlus) {
                kernelImage = (ImagePlus) kernel;
                // For now, ignoring custom kernel shape since ImageJ core erode() doesn't take one
                ip.erode();
            } else if (kernel instanceof List) {
                try {
                    @SuppressWarnings("unchecked")
                    List\<List\<Integer\>\> kernelList = (List\<List\<Integer\>\>) kernel;
                    kernelImage = fromList(kernelList);
                    ip.erode();  // Or apply logic using kernelImage if needed
                } catch (Exception e) {
                    System.err.println("Invalid kernel List format");
                    ip.erode();
                }
            } else {
                System.err.println("Unsupported kernel type: " + kernel.getClass());
                ip.erode(); // fallback
            }
    
            return new ImagePlus("Eroded", ip);
        }

        public static ImagePlus open(ImagePlus input, Object kernel) {
            ImageProcessor ip = input.getProcessor().duplicate();

            ImagePlus kernelImage = null;

            if (kernel == null) {
                // Default behavior with no kernel
                open(input, null);  // ImageJ's basic erosion
                return new ImagePlus("Open", ip);
            } else if (kernel instanceof ImagePlus) {
                kernelImage = (ImagePlus) kernel;
                // For now, ignoring custom kernel shape since ImageJ core erode() doesn't take one
                open(input, kernelImage);
            } else if (kernel instanceof List) {
                try {
                    @SuppressWarnings("unchecked")
                    List\<List\<Integer\>\> kernelList = (List\<List\<Integer\>\>) kernel;
                    kernelImage = fromList(kernelList);
                    open(input, kernelImage);  // Or apply logic using kernelImage if needed
                } catch (Exception e) {
                    System.err.println("Invalid kernel List format");
                    open(input, kernel);
                }
            } else {
                System.err.println("Unsupported kernel type: " + kernel.getClass());
                ip.dilate(); // fallback
            }

            return new ImagePlus("Open", ip);
        }

