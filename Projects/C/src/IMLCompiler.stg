        public static ImagePlus adjustHorizontalScale(ImagePlus img, double scale) {
            ImageProcessor ip = img.getProcessor().duplicate();
            int newWidth = (int) Math.round(ip.getWidth() * scale);
            ImageProcessor resized = ip.resize(newWidth, ip.getHeight(), true);
            ImagePlus result = new ImagePlus(img.getTitle()+" (h-scaled)", resized);
            result.setCalibration(img.getCalibration().copy());
            return result;
        }
        
        public static ImagePlus adjustVerticalScale(ImagePlus img, double scale) {
            ImageProcessor ip = img.getProcessor().duplicate();
            int newHeight = (int) Math.round(ip.getHeight() * scale);
            ImageProcessor resized = ip.resize(ip.getWidth(), newHeight, true);
            ImagePlus result = new ImagePlus(img.getTitle()+" (v-scaled)", resized);
            result.setCalibration(img.getCalibration().copy());
            return result;
        }

        public static ImagePlus multiply(double scalar, ImagePlus img) {
            ImageProcessor proc = img.getProcessor().convertToFloat().duplicate();
            proc.multiply(scalar);
            return new ImagePlus("multiplied", proc);
        }

        public static ImagePlus multiply(ImagePlus img, double scalar) {
            return multiply(scalar, img); // delega para a versão correta
        }


        public static ImagePlus add(ImagePlus img1, ImagePlus img2) {
            if (img1 == null || img2 == null) {
                System.err.println("Uma das imagens é nula.");
                return null;
            }
        
            // Verifica se as imagens têm o mesmo tamanho
            int width1 = img1.getWidth();
            int height1 = img1.getHeight();
            int width2 = img2.getWidth();
            int height2 = img2.getHeight();
        
            if (width1 != width2 || height1 != height2) {
                System.err.println("As imagens devem ter o mesmo tamanho para serem somadas.");
                return null;
            }
        
            ImageProcessor proc1 = img1.getProcessor().duplicate();
            ImageProcessor proc2 = img2.getProcessor();
        
            proc1.copyBits(proc2, 0, 0, Blitter.ADD);  // Soma pixel a pixel
        
            return new ImagePlus("Added Image", proc1);
        }

