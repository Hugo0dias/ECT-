        }

        private interface PixelPredicate {
            boolean test(int pixelValue);
        }

        public static boolean allPixelGreaterThan(Object input, int threshold) {
            return apply(input, p -\> p \> threshold);
        }

        public static boolean allPixelLessThan(Object input, int threshold) {
            return apply(input, p -\> p \< threshold);
        }

        public static boolean allPixelEqualTo(Object input, int value) {
            return apply(input, p -\> p == value);
        }

        public static boolean allPixelDifferentThan(Object input, int value) {
            return apply(input, p -\> p != value);
        }

        public static boolean allPixelLessOrEqualThan(Object input, int value) {
            return apply(input, p -\> p \<= value);
        }

        public static boolean allPixelGreaterOrEqualThan(Object input, int value) {
            return apply(input, p -\> p \>= value);
        }

        private static boolean apply(Object input, PixelPredicate predicate) {
            if (input instanceof List) {
                List\<?\> list = (List\<?\>) input;
                for (Object obj : list) {
                    int val = (obj instanceof Boolean) ? ((Boolean) obj ? 1 : 0) : (int) obj;
                    if (!predicate.test(val)) return false;
                }
                return true;
            } else if (input instanceof ImagePlus) {
                ImageProcessor proc = ((ImagePlus) input).getProcessor();
                int width = proc.getWidth();
                int height = proc.getHeight();
                for (int y = 0; y \< height; y++) {
                    for (int x = 0; x \< width; x++) {
                        int pixelVal = proc.getPixel(x, y);
                        if (!predicate.test(pixelVal)) return false;
                    }
                }
                return true;
            } else {
                throw new IllegalArgumentException("Input must be either a List or an ImagePlus.");
            }
        }


        public static ImagePlus openImage(String path) {
            return IJ.openImage(path);
        }

        public static void showImage(ImagePlus img, String title) {
            img.setTitle(title);
            img.show();
        }

        public static ImagePlus morphOperation(ImagePlus img, String op, int kernelSize) {
            ImageProcessor ip = img.getProcessor().duplicate();

            switch (op.toLowerCase()) {
                case "open":
                    new Binary().setup("open", null);
                    new Binary().run(ip);
                    break;
                case "close":
                    new Binary().setup("close", null);
                    new Binary().run(ip);
                    break;
                case "erode":
                    ip.erode();
                    break;
                case "dilate":
                    ip.dilate();
                    break;
                default:
                    throw new IllegalArgumentException("Unsupported operation: " + op);
            }

            return new ImagePlus("Morph Result", ip);
        }

        public static void saveImage(ImagePlus img, String path) {
            new FileSaver(img).saveAsPgm(path);
        }

        public static int columns(ImagePlus img) {
