// Test: Assignment without redeclaration
number x is 10
number y is 20  // This line declares 'y' without redeclaring 'x'
x is x + y  // This line modifies 'x' using the value of 'y'
y is x * 2  // This line modifies 'y' based on the new value of 'x'
image size 100 by 100 background 0
place circle radius x at y y with intensity 255